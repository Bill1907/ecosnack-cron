# Database (NEON PostgreSQL)
# 연결 풀 설정:
# - connection_limit: 동시 연결 수 제한 (권장: 10)
# - pool_timeout: 연결 획득 대기 시간(초) (권장: 10)
# - connect_timeout: 연결 타임아웃(초) - NEON 콜드스타트 대비 (권장: 30)
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require&connection_limit=10&pool_timeout=10&connect_timeout=30

# OpenAI API (필수)
OPENAI_API_KEY=sk-your-openai-api-key-here
# 글 생성(기사 분석, 리포트). gpt-5 이후 모델은 max_tokens/temperature 를 받지 않는다
OPENAI_MODEL=gpt-6-luna
# Jev 확신도가 낮을 때 다시 판정하는 모델
OPENAI_FALLBACK_JUDGE_MODEL=gpt-5.6-luna

# TypeSafe Jev (필수) - 제목/품질 점수, 근거 검증, 리포트 품질 평가
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_MODEL=jev-1.13.0

# 날짜 계산은 TZ 와 무관하게 KST 로 고정되어 있다 (src/utils/kst.ts)
